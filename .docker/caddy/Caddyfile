# Local development edge that mirrors the production Caddy routing in
# deploy/caddy/Caddyfile: a single origin serves the web app, and the
# reserved /_roomote-api/* prefix is stripped and proxied to the API.
#
# `pnpm dev` points the ngrok web tunnel at this listener instead of the
# web app, and derives TRPC_URL as <public-url>/_roomote-api — the same
# contract deployed environments get. That makes the API reachable from
# hosted compute workers (Vercel Sandbox, Modal, Daytona), which could not
# call back into an unreachable localhost TRPC_URL.
#
# Intentionally out of scope compared to production:
# - TLS: ngrok terminates TLS in front of this listener.
# - Preview subdomains: the local preview proxy keeps its own port (18081).
# - MinIO artifact routing: dev presigned S3 URLs point directly at MinIO.
{
	auto_https off
}

:18080 {
	encode zstd gzip

	@api {
		path /_roomote-api /_roomote-api/*
	}

	handle @api {
		uri strip_prefix /_roomote-api
		reverse_proxy host.docker.internal:13001 {
			lb_try_duration 10s
			lb_try_interval 250ms
		}
	}

	handle {
		reverse_proxy host.docker.internal:13000 {
			lb_try_duration 10s
			lb_try_interval 250ms
		}
	}
}
