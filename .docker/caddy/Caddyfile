# Local development edge that mirrors the production Caddy routing in
# deploy/caddy/Caddyfile: a single origin serves the web app, and the
# reserved /_roomote-api/* prefix is stripped and proxied to the API.
#
# `pnpm dev` points the ngrok web tunnel at this listener instead of the
# web app, and derives TRPC_URL as <public-url>/_roomote-api — the same
# contract deployed environments get. That makes the API reachable from
# hosted compute workers (Vercel Sandbox, Modal, Daytona), which could not
# call back into an unreachable localhost TRPC_URL.
#
# Intentionally out of scope compared to production:
# - TLS: ngrok terminates TLS in front of this listener.
# - Preview subdomains: the local preview proxy keeps its own port (18081).
{
	auto_https off
}

:18080 {
	encode zstd gzip

	@artifact_storage {
		path /{$S3_BUCKET_ARTIFACTS:roomote-artifacts} /{$S3_BUCKET_ARTIFACTS:roomote-artifacts}/*
	}

	handle @artifact_storage {
		reverse_proxy minio:9000 {
			# Presigned S3 URLs sign the bucket path and Host header.
			header_up Host {http.request.host}
		}
	}

	@api {
		path /_roomote-api /_roomote-api/*
	}

	handle @api {
		uri strip_prefix /_roomote-api
		reverse_proxy host.docker.internal:13101 {
			lb_try_duration 10s
			lb_try_interval 250ms
		}
	}

	# Route the sandbox-server transport through the same public origin as the
	# web app. A browser opened through ngrok cannot connect to the worker's
	# loopback-only published port directly because 127.0.0.1 would refer to the
	# browser device. The preview proxy resolves the task's current worker port
	# after Caddy translates this path route into its normal virtual host.
	@local_sandbox path_regexp local_sandbox ^/_roomote-sandbox/([a-z0-9]+)(/.*)$

	handle @local_sandbox {
		rewrite * {re.local_sandbox.2}
		reverse_proxy host.docker.internal:18081 {
			header_up Host {re.local_sandbox.1}-sandbox-server.roomotepreview.localhost:18081
			lb_try_duration 10s
			lb_try_interval 250ms
		}
	}

	handle {
		reverse_proxy host.docker.internal:13100 {
			lb_try_duration 10s
			lb_try_interval 250ms
		}
	}
}
