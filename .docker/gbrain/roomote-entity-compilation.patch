+/**
+ * Roomote's bounded entity compiler owns one marker-delimited prose section
+ * on deterministic person pages. The operation performs the merge inside
+ * gbrain so private Facts/Takes fences never cross the remote read boundary.
+ * It delegates the resulting full page to put_page so chunks, embeddings,
+ * versions, and filesystem write-through retain the canonical behavior.
+ */
+const replace_compiled_section: Operation = {
+  name: 'replace_compiled_section',
+  description: 'Replace one explicitly marked compiled-truth section while preserving the rest of the page, including Facts, Takes, frontmatter, and timeline.',
+  params: {
+    slug: { type: 'string', required: true, description: 'Page slug' },
+    start_marker: { type: 'string', required: true, description: 'Exact opening marker already present once in compiled truth' },
+    end_marker: { type: 'string', required: true, description: 'Exact closing marker already present once in compiled truth' },
+    content: { type: 'string', required: true, description: 'Replacement content between the markers' },
+  },
+  mutating: true,
+  scope: 'write',
+  handler: async (ctx, p) => {
+    const slug = p.slug as string;
+    const startMarker = p.start_marker as string;
+    const endMarker = p.end_marker as string;
+    enforceSubagentSlugFence(ctx, slug, 'replace_compiled_section');
+    enforceClientSlugFence(ctx, slug, 'replace_compiled_section');
+
+    if (!startMarker || !endMarker || startMarker === endMarker) {
+      throw new OperationError('invalid_params', 'replace_compiled_section requires two distinct non-empty markers');
+    }
+    const replacement = (p.content as string).trim();
+    if (replacement.includes(startMarker) || replacement.includes(endMarker)) {
+      throw new OperationError('invalid_params', 'replace_compiled_section content must not contain its boundary markers');
+    }
+    if (replacement.includes('<!-- roomote:identity:start -->') || replacement.includes('<!-- roomote:identity:end -->')) {
+      throw new OperationError('invalid_params', 'replace_compiled_section content must not contain identity boundary markers');
+    }
+    const page = await ctx.engine.getPage(slug, { sourceId: ctx.sourceId ?? 'default' });
+    if (!page) {
+      throw new OperationError('page_not_found', `Page not found: ${slug}`);
+    }
+    const start = page.compiled_truth.indexOf(startMarker);
+    const end = page.compiled_truth.indexOf(endMarker);
+    if (
+      start < 0 ||
+      end < start + startMarker.length ||
+      page.compiled_truth.indexOf(startMarker, start + startMarker.length) >= 0 ||
+      page.compiled_truth.indexOf(endMarker, end + endMarker.length) >= 0
+    ) {
+      throw new OperationError(
+        'invalid_params',
+        `replace_compiled_section expected exactly one ordered marker pair on '${slug}'`,
+      );
+    }
+    const nextCompiledTruth =
+      page.compiled_truth.slice(0, start + startMarker.length) +
+      '\n' +
+      replacement +
+      '\n' +
+      page.compiled_truth.slice(end);
+    const tags = await ctx.engine.getTags(page.slug, { sourceId: page.source_id });
+    const fullContent = serializeMarkdown(
+      page.frontmatter ?? {},
+      nextCompiledTruth,
+      page.timeline ?? '',
+      { type: page.type, title: page.title, tags },
+    );
+
+    return put_page.handler(ctx, { slug, content: fullContent });
+  },
+};
+
+/**
+ * Deterministic identity refreshes are also section-scoped. On legacy pages
+ * without markers, prepend the new managed sections and retain the complete
+ * prior body as preserved context rather than risking a lossy migration.
+ */
+const upsert_entity_identity: Operation = {
+  name: 'upsert_entity_identity',
+  description: 'Create a canonical entity page or update only its deterministic identity section while preserving generated prose, Facts, Takes, and timeline.',
+  params: {
+    slug: { type: 'string', required: true, description: 'Page slug' },
+    content: { type: 'string', required: true, description: 'Full deterministic entity projection used for create and identity-section replacement' },
+  },
+  mutating: true,
+  scope: 'write',
+  handler: async (ctx, p) => {
+    const slug = p.slug as string;
+    enforceSubagentSlugFence(ctx, slug, 'upsert_entity_identity');
+    enforceClientSlugFence(ctx, slug, 'upsert_entity_identity');
+    if (ctx.dryRun) return { dry_run: true, action: 'upsert_entity_identity', slug };
+
+    const existing = await ctx.engine.getPage(slug, { sourceId: ctx.sourceId ?? 'default' });
+    if (!existing) return put_page.handler(ctx, p);
+
+    const incoming = parseMarkdown(p.content as string, slug);
+    const identityStart = '<!-- roomote:identity:start -->';
+    const identityEnd = '<!-- roomote:identity:end -->';
+    const activityStart = '<!-- roomote:compiled-activity:start -->';
+    const activityEnd = '<!-- roomote:compiled-activity:end -->';
+    const extractBlock = (body: string, startMarker: string, endMarker: string): string => {
+      const start = body.indexOf(startMarker);
+      const end = body.indexOf(endMarker, start + startMarker.length);
+      if (start < 0 || end < start) {
+        throw new OperationError('invalid_params', `upsert_entity_identity requires ${startMarker} and ${endMarker}`);
+      }
+      return body.slice(start, end + endMarker.length);
+    };
+    const identityBlock = extractBlock(incoming.compiled_truth, identityStart, identityEnd);
+    const existingIdentityStart = existing.compiled_truth.indexOf(identityStart);
+    const existingIdentityEnd = existing.compiled_truth.indexOf(identityEnd, existingIdentityStart + identityStart.length);
+    let nextCompiledTruth: string;
+    if (existingIdentityStart >= 0 && existingIdentityEnd >= existingIdentityStart) {
+      nextCompiledTruth =
+        existing.compiled_truth.slice(0, existingIdentityStart) +
+        identityBlock +
+        existing.compiled_truth.slice(existingIdentityEnd + identityEnd.length);
+    } else {
+      const hasActivityBlock = existing.compiled_truth.includes(activityStart) && existing.compiled_truth.includes(activityEnd);
+      const activityBlock = hasActivityBlock
+        ? ''
+        : `${extractBlock(incoming.compiled_truth, activityStart, activityEnd)}\n\n`;
+      nextCompiledTruth = `${identityBlock}\n\n${activityBlock}## Preserved context\n\n${existing.compiled_truth}`;
+    }
+
+    const nextFrontmatter = { ...(existing.frontmatter ?? {}) };
+    for (const key of ['aliases', 'status', 'event_date', 'job_title', 'provenance']) {
+      delete nextFrontmatter[key];
+      if (key in incoming.frontmatter) nextFrontmatter[key] = incoming.frontmatter[key];
+    }
+    const tags = await ctx.engine.getTags(existing.slug, { sourceId: existing.source_id });
+    const fullContent = serializeMarkdown(
+      nextFrontmatter,
+      nextCompiledTruth,
+      existing.timeline ?? '',
+      { type: incoming.type, title: incoming.title, tags },
+    );
+
+    return put_page.handler(ctx, { slug, content: fullContent });
+  },
+};
+
 // (Page CRUD quartet first, then the v0.26.5 destructive-guard ops:
