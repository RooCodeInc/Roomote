# Collapse test-heavy paths and common test file patterns by default in GitHub diffs
**/*.test.* linguist-generated=true

# Mark Drizzle meta snapshot files as generated
packages/db/drizzle/meta/*_snapshot.json linguist-generated=true

# Shell scripts must retain LF endings so Bash works in Windows Git checkouts.
*.sh text eol=lf
deploy/host/roomote text eol=lf
deploy/scripts/roomote-deploy text eol=lf
