branch="$(git rev-parse --abbrev-ref HEAD)"

if [ "$branch" = "main" ]; then
  echo "You can't push directly to main - please check out a branch."
  exit 1
fi

npx lint-staged || exit $?
# The managed wrapper runs Judgement after this hook, using task inference.
if [ "${R_JUDGEMENT_MANAGED:-}" != "1" ]; then
  pnpm judgement --hook
fi
