{
  "ruleId": "criterion_1",
  "examples": [
    {
      "name": "Clearly synthetic credential placeholder",
      "path": ".env.example",
      "before": "TOKEN=\n",
      "after": "TOKEN=REPLACE_WITH_YOUR_TOKEN\n",
      "expected": "pass"
    },
    {
      "name": "Server-side credential lookup",
      "path": "apps/api/src/config.ts",
      "before": "export const config = {};\n",
      "after": "export const config = { apiKey: process.env.PROVIDER_API_KEY };\n",
      "expected": "pass"
    },
    {
      "name": "Redacted diagnostic example",
      "path": "docs/troubleshooting.md",
      "before": "Example output:\n",
      "after": "Example output: {\"authorization\":\"[REDACTED]\"}\n",
      "expected": "pass"
    },
    {
      "name": "Public configuration",
      "path": "src/config.ts",
      "before": "export const options = {};\n",
      "after": "export const options = { timeoutMs: 3000, retries: 2 };\n",
      "expected": "pass"
    },
    {
      "name": "Unmistakably fictional fixture",
      "path": "test/users.fixture.ts",
      "before": "export const users = [];\n",
      "after": "export const users = [{ name: \"Synthetic Test User\", email: \"test-user@example.invalid\" }];\n",
      "expected": "pass"
    },
    {
      "name": "Remove a placeholder from an example",
      "path": ".env.example",
      "before": "API_KEY=REPLACE_WITH_YOUR_KEY\n",
      "after": "API_KEY=\n",
      "expected": "pass"
    }
  ]
}
