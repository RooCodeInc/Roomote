{
  "name": "@roomote/api",
  "version": "0.0.3",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint src --ext=ts --max-warnings=0",
    "check-types": "tsc --noEmit",
    "check-types:fast": "tsgo --noEmit",
    "test": "dotenvx run  -f ../../.env.test -- vitest",
    "dev": "bash ./scripts/watchman.sh",
    "dev:prepare": "rimraf dist",
    "build": "tsup --clean",
    "start": "node dist/index.js",
    "clean": "rimraf dist .turbo",
    "internal-deps": "pnpm list --filter @roomote/api --depth Infinity 2>/dev/null | grep -E '@roomote/' | grep 'link:' | sed 's/.*@roomote/@roomote/' | sed 's/ link:.*//' | sort -u"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1000.0",
    "@aws-sdk/s3-request-presigner": "3.1000.0",
    "@hono/node-server": "2.0.10",
    "@hono/trpc-server": "^0.4.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@octokit/openapi-webhooks-types": "^12.1.0",
    "@octokit/webhooks": "^14.2.0",
    "@roomote/ado": "workspace:^",
    "@roomote/auth": "workspace:^",
    "@roomote/bitbucket": "workspace:^",
    "@roomote/cloud-agents": "workspace:^",
    "@roomote/communication": "workspace:^",
    "@roomote/compute-providers": "workspace:^",
    "@roomote/db": "workspace:^",
    "@roomote/env": "workspace:^",
    "@roomote/gitea": "workspace:^",
    "@roomote/github": "workspace:^",
    "@roomote/gitlab": "workspace:^",
    "@roomote/linear": "workspace:^",
    "@roomote/redis": "workspace:^",
    "@roomote/sdk": "workspace:^",
    "@roomote/slack": "workspace:^",
    "@roomote/telemetry": "workspace:^",
    "@roomote/types": "workspace:^",
    "@sentry/node": "10.45.0",
    "@trpc/client": "^11.15.0",
    "@trpc/server": "^11.15.0",
    "hono": "4.12.34",
    "jose": "^6.2.3",
    "p-map": "^7.0.4",
    "snowflake-sdk": "^2.4.3",
    "undici": "^7.29.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@roomote/config-eslint": "workspace:^",
    "@roomote/config-typescript": "workspace:^",
    "@types/node": "^24.10.13",
    "tsup": "^8.5.1",
    "vitest": "^4.1.1"
  }
}
