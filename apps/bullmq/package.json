{
  "name": "@roomote/bullmq",
  "version": "0.0.3",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src --ext=ts --max-warnings=0",
    "check-types": "tsc --noEmit",
    "check-types:fast": "tsgo --noEmit",
    "test": "dotenvx run -f ../../.env.test -- vitest",
    "dev": "bash ./scripts/watchman.sh",
    "dev:prepare": "rimraf dist",
    "build": "tsup --clean",
    "start": "node dist/index.js",
    "clean": "rimraf dist .turbo",
    "internal-deps": "pnpm list --filter @roomote/bullmq --depth Infinity 2>/dev/null | grep -E '@roomote/' | grep 'link:' | sed 's/.*@roomote/@roomote/' | sed 's/ link:.*//' | sort -u"
  },
  "dependencies": {
    "@bull-board/api": "^6.16.4",
    "@bull-board/hono": "^6.16.4",
    "@bull-board/ui": "^6.16.4",
    "@hono/node-server": "1.19.13",
    "@roomote/cloud-agents": "workspace:^",
    "@roomote/communication": "workspace:^",
    "@roomote/compute-providers": "workspace:^",
    "@roomote/db": "workspace:^",
    "@roomote/discord-gateway": "workspace:^",
    "@roomote/env": "workspace:^",
    "@roomote/linear": "workspace:^",
    "@roomote/sdk": "workspace:^",
    "@roomote/slack": "workspace:^",
    "@roomote/telemetry": "workspace:^",
    "@roomote/types": "workspace:^",
    "@sentry/node": "10.45.0",
    "bullmq": "^5.78.0",
    "hono": "4.12.25",
    "ioredis": "^5.10.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@roomote/config-eslint": "workspace:^",
    "@roomote/config-typescript": "workspace:^",
    "@types/node": "^24.10.13",
    "tsup": "^8.5.1",
    "vitest": "^4.1.1"
  }
}
