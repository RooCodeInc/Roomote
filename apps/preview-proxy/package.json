{
  "name": "@roomote/preview-proxy",
  "version": "0.0.2",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "check-types": "tsc --noEmit",
    "check-types:fast": "tsgo --noEmit",
    "test": "dotenvx run -f ../../.env.test -- vitest",
    "dev": "bash ./scripts/watchman.sh",
    "dev:prepare": "rimraf dist",
    "build": "tsup --clean",
    "start": "node --enable-source-maps dist/index.js",
    "clean": "rimraf .turbo dist",
    "internal-deps": "pnpm list --filter @roomote/preview-proxy --depth Infinity 2>/dev/null | grep -E '@roomote/' | grep 'link:' | sed 's/.*@roomote/@roomote/' | sed 's/ link:.*//' | sort -u"
  },
  "dependencies": {
    "@roomote/auth": "workspace:^",
    "@roomote/cloud-agents": "workspace:^",
    "@roomote/db": "workspace:^",
    "@roomote/env": "workspace:^",
    "@roomote/redis": "workspace:^",
    "@roomote/types": "workspace:^",
    "http-proxy": "^1.18.1",
    "pino": "^9.7.0",
    "pino-pretty": "^13.1.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@roomote/config-eslint": "workspace:^",
    "@roomote/config-typescript": "workspace:^",
    "@types/http-proxy": "^1.17.16",
    "@types/node": "^24.10.13",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4",
    "tsup": "^8.5.1",
    "vitest": "^4.1.1"
  }
}
