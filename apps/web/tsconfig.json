{
  "extends": "@roomote/config-typescript/nextjs.json",
  "compilerOptions": {
    "types": ["vitest/globals", "@testing-library/jest-dom"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts",
    "vitest*.ts",
    "scripts/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
