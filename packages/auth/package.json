{
  "name": "@roomote/auth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    },
    "./client": {
      "types": "./src/client.ts",
      "import": "./src/client.ts",
      "require": "./src/client.ts"
    }
  },
  "typesVersions": {
    "*": {
      "client": [
        "./src/client.ts"
      ]
    }
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src --ext=ts --max-warnings=0",
    "check-types": "tsc --noEmit",
    "check-types:fast": "tsgo --noEmit",
    "test": "dotenvx run -f ../../.env.test -- vitest",
    "development:create-auth-token": "dotenvx run --quiet -f ../../.env.local -- tsx scripts/create-auth-token.ts",
    "development:create-job-token": "dotenvx run --quiet -f ../../.env.local -- tsx scripts/create-job-token.ts",
    "development:create-github-token": "dotenvx run --quiet -f ../../.env.local -- tsx scripts/create-github-token.ts",
    "clean": "rimraf .turbo"
  },
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "@roomote/db": "workspace:^",
    "@roomote/env": "workspace:^",
    "@roomote/types": "workspace:^",
    "jsonwebtoken": "^9.0.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@roomote/config-eslint": "workspace:^",
    "@roomote/config-typescript": "workspace:^",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.13",
    "vitest": "^4.1.1"
  }
}
