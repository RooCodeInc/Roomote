{
  "name": "@roomote/compute-providers",
  "version": "0.0.2",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    },
    "./factory": {
      "types": "./src/factory.ts",
      "import": "./src/factory.ts",
      "require": "./src/factory.ts"
    }
  },
  "typesVersions": {
    "*": {
      "factory": [
        "./src/factory.ts"
      ]
    }
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src --ext=ts --max-warnings=0",
    "check-types": "tsc --noEmit",
    "check-types:fast": "tsgo --noEmit",
    "test": "dotenvx run -f ../../.env.test -- vitest run",
    "clean": "rimraf .turbo"
  },
  "dependencies": {
    "@daytonaio/sdk": "^0.190.1",
    "@roomote/env": "workspace:^",
    "@roomote/types": "workspace:^",
    "e2b": "^2.31.0",
    "jsonwebtoken": "^9.0.3",
    "lru-cache": "^11.2.6",
    "modal": "^0.7.6"
  },
  "devDependencies": {
    "@roomote/config-eslint": "workspace:^",
    "@roomote/config-typescript": "workspace:^",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.1.0",
    "vitest": "^4.1.1"
  }
}
