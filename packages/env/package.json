{
  "name": "@roomote/env",
  "version": "0.0.3",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "format": "oxfmt \"**/*.{js,jsx,ts,tsx,json,css}\"",
    "format:check": "oxfmt --check \"**/*.{js,jsx,ts,tsx,json,css}\"",
    "check-types": "tsc --noEmit",
    "check-types:fast": "tsgo --noEmit",
    "test": "dotenvx run -f ../../.env.test -- vitest",
    "clean": "rimraf .turbo"
  },
  "dependencies": {
    "@roomote/types": "workspace:^",
    "@t3-oss/env-nextjs": "^0.13.10",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@roomote/config-typescript": "workspace:^",
    "@types/node": "^24.10.13",
    "vitest": "^4.1.1"
  }
}
