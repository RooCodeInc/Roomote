{
  "name": "@roomote/telemetry",
  "version": "0.0.3",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    },
    "./server": {
      "types": "./src/server/index.ts",
      "import": "./src/server/index.ts",
      "require": "./src/server/index.ts"
    }
  },
  "typesVersions": {
    "*": {
      "server": [
        "./src/server/index.ts"
      ]
    }
  },
  "scripts": {
    "format": "oxfmt \"**/*.{js,jsx,ts,tsx,json,css}\"",
    "format:check": "oxfmt --check \"**/*.{js,jsx,ts,tsx,json,css}\"",
    "lint": "eslint src --ext=ts --max-warnings=0",
    "check-types": "tsc --noEmit",
    "check-types:fast": "tsgo --noEmit",
    "test": "vitest",
    "clean": "rimraf .turbo"
  },
  "dependencies": {
    "@roomote/db": "workspace:^",
    "@roomote/env": "workspace:^",
    "@roomote/feature-flags": "workspace:^"
  },
  "devDependencies": {
    "@roomote/config-eslint": "workspace:^",
    "@roomote/config-typescript": "workspace:^",
    "@types/node": "^24.10.13",
    "vitest": "^4.1.1"
  }
}
